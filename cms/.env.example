HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── Base de données ──
# Défaut : SQLite (développement local, fichier .tmp/data.db).
# Cible : PostgreSQL — décommenter et renseigner.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=darsafia
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# ── Site Next.js (CORS, revalidation) ──
# FRONTEND_URL=http://localhost:3000

# ── Langues du contenu ──
# Le site est en français (source), anglais et arabe. La langue PAR DÉFAUT de
# Strapi doit être le français : `npm run seed` crée fr / en / ar et fixe fr par
# défaut ; sur une base neuve, cette variable le fait dès le premier démarrage.
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr
