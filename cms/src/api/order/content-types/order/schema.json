{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Commande",
    "description": "Demande de commande reçue par le site. Création uniquement par l'API ; gestion dans l'admin."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reference": {
      "type": "string",
      "unique": true,
      "maxLength": 32
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "new",
      "required": true
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "product-form",
        "cart"
      ],
      "required": true
    },
    "firstName": {
      "type": "string",
      "maxLength": 80
    },
    "lastName": {
      "type": "string",
      "maxLength": 80
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "wilaya": {
      "type": "string",
      "maxLength": 80
    },
    "commune": {
      "type": "string",
      "maxLength": 120
    },
    "deliveryMethod": {
      "type": "enumeration",
      "enum": [
        "main",
        "societe"
      ]
    },
    "deliveryCompany": {
      "type": "string",
      "maxLength": 120
    },
    "deliveryAddress": {
      "type": "text",
      "maxLength": 400
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "orders.order-item",
      "required": true,
      "min": 1
    },
    "subtotal": {
      "type": "integer",
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "DZD"
      ],
      "default": "DZD"
    },
    "locale": {
      "type": "enumeration",
      "enum": [
        "fr",
        "ar",
        "en"
      ],
      "default": "fr"
    },
    "internalNote": {
      "type": "text"
    }
  }
}
