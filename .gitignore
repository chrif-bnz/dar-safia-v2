# Dépendances
node_modules/
.pnpm-store/

# Images dérivées — régénérées par `npm run prepare-assets` depuis les masters
# (branding images/, perfumes/, logo/). Ne pas versionner.
public/img/*
!public/img/logo/
public/img/logo/*
!public/img/logo/logo-dr/
public/img/logo/logo-dr/*
!public/img/logo/logo-dr/logo-navbar-monogramme.png
web/public/img/*
!web/public/img/logo/
web/public/img/logo/*
!web/public/img/logo/logo-dr/
web/public/img/logo/logo-dr/*
!web/public/img/logo/logo-dr/logo-navbar-monogramme.png

# Catalogue migré — régénéré par `node scripts/migrate-catalog.mjs`
# depuis catalog-data.js, qui reste la source. Ne pas versionner :
# éditer le JSON généré serait perdu au prochain lancement.
web/src/data/

# Environnement — ne jamais commiter de valeurs réelles
.env
.env.*
!.env.example

# Éditeurs / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
