# ══════════════════════════════════════════════
#   DAR SAFIA — VARIABLES D'ENVIRONNEMENT
# ══════════════════════════════════════════════
# Copiez ce fichier vers .env pour surcharger les valeurs par défaut.
# .env n'est jamais commité (voir .gitignore).
#
# ⚠️ Tout ce qui est préfixé NEXT_PUBLIC_ est injecté dans le bundle client et
# donc PUBLIC. N'y placez jamais de secret.

# ── URL publique du site ──
# Sert aux URL absolues du SEO (canonical, hreflang, sitemap, Open Graph).
# Valeur publique, pas un secret. Si vide : variable URL fournie par Netlify,
# sinon http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Conciergerie ──
# Numéro WhatsApp, format international sans « + » ni espaces. Laissé vide,
# le numéro réel codé dans src/lib/whatsapp.ts s'applique.
NEXT_PUBLIC_WHATSAPP_PHONE=

# ── Source du catalogue ──
# `static` (défaut) : les JSON générés dans web/src/data par
#   `node scripts/migrate-catalog.mjs` depuis catalog-data.js.
# `strapi` : l'API Strapi. Demande alors STRAPI_URL et STRAPI_API_TOKEN.
CATALOG_SOURCE=static

# ── Strapi (uniquement si CATALOG_SOURCE=strapi) ──
# Le CMS vit dans cms/ (voir cms/.env.example) ; on ne parle à Strapi que par HTTP.
# STRAPI_API_TOKEN est un SECRET : pas de préfixe NEXT_PUBLIC_, jamais commité.
STRAPI_URL=
# Lecture seule du catalogue. Générer avec `npm run tokens:create` dans cms/.
STRAPI_API_TOKEN=
# Création seule de commandes et de messages de contact (routes /api/orders et
# /api/contact du site). Indépendant de CATALOG_SOURCE : si vide, le site
# fonctionne comme avant (WhatsApp seul, rien n'est enregistré).
STRAPI_FORMS_TOKEN=
# Durée de revalidation ISR, en secondes.
STRAPI_REVALIDATE=
